# Copy this file to .env when you want to override the local stack.
QUAKE_SCOPE_PORT=3000
QUAKE_SCOPE_API_PORT=8080
POSTGRES_PORT=5432
QUAKE_SCOPE_BIND_ADDRESS=0.0.0.0
QUAKE_SCOPE_API_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=quake_scope
POSTGRES_USER=quake_scope
POSTGRES_PASSWORD=local-only-change-me

USGS_INGESTION_ENABLED=true
USGS_CATCH_UP_ENABLED=true
